<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StockTvKiosk.App</RootNamespace>
    <AssemblyName>StockTvKiosk</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Zielplattformen laut Projektvorgabe: Entwicklung auf Windows, Betrieb auf Raspberry Pi 4. -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Die XML-Kommentare werden von Swagger als Beschreibung der Endpunkte angezeigt.
         1591 aus: fuer die Avalonia- und Konfigurationsklassen sind sie nicht gefordert. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.WebView" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die REST-Schnittstelle laeuft auf Kestrel im selben Prozess wie die Fenster.
         Microsoft.Extensions.Logging und .Console kommen ueber dieses Framework mit und
         brauchen deshalb keinen eigenen PackageReference mehr (NU1510). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockTvKiosk.Core\StockTvKiosk.Core.csproj" />
  </ItemGroup>

</Project>
