{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    },
    "File": {
      "Enabled": true,
      "Directory": "_logs",
      "FileName": "kiosk.log",
      "MaxFileSizeBytes": 5242880,
      "RetainedFileCount": 3
    }
  },

  "Kiosk": {
    "Urls": {
      "PrimaryUrl": "http://localhost:5129/turnier",
      "SecondaryUrl": "http://localhost:5129/display2",
      "Demo": false
    },

    "Display": {
      "Dual": true,
      "UseSecondScreen": true,
      "MainDisplayIndex": -1,
      "MirrorDisplayIndex": -1,
      "SingleScreenFallback": "SideBySide",
      "WindowMode": "Borderless",
      "UseWorkingArea": false,
      "TreatDuplicatedAsSingleScreen": true,
      "HideCursor": true,
      "AllowExitShortcut": true
    },

    "Retry": {
      "Enabled": true,
      "IntervalSeconds": 5,
      "ShowErrorPage": true,
      "ProbeTimeoutSeconds": 5
    },

    "BlazorHost": {
      "Enabled": false,
      "ExecutablePath": null,
      "ExecutableName": "StockTvBlazor",
      "SearchRoot": null,
      "Arguments": null,
      "WorkingDirectory": null,
      "Environment": {
        "ASPNETCORE_URLS": "http://localhost:5129"
      },
      "StopExistingInstance": true,
      "ReadinessTimeoutSeconds": 60,
      "ShutdownWithKiosk": true,
      "LogDirectory": "_logs"
    }
  }
}
