<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Bewusst nur nuget.org: die global konfigurierten Feeds (Telerik, lokales FileSystem)
    werden ausgeblendet, damit der Build auf jedem Rechner und in CI reproduzierbar ist
    und die zentrale Paketverwaltung nicht NU1507 meldet.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
